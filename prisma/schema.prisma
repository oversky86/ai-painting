// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model GenerationJob {
  id              String   @id @default(cuid())
  shop            String
  petPhotoUrl     String
  paintingStyle   String
  prompt          String
  status          String   @default("pending") // pending → processing → completed → failed
  resultUrl       String?
  replicateId     String?  // Replicate prediction ID for polling
  shopifyOrderId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orderRecords    OrderRecord[]
}

model PaintingStyle {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  prompt      String
  previewUrl  String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model OrderRecord {
  id              String   @id @default(cuid())
  shop            String
  shopifyOrderId  String   @unique
  generationJobId String
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id])
  customerEmail   String?
  totalAmount     String?
  createdAt       DateTime @default(now())
}

// Merchant-configurable rate limit settings (one per shop)
model ShopRateLimit {
  id                    Int      @id @default(autoincrement())
  shop                  String   @unique
  dailyLimitLoggedIn    Int      @default(5)
  dailyLimitAnonymous   Int      @default(3)
  updatedAt             DateTime @updatedAt
}

// Daily generation usage counter (per IP or customer_id)
model GenerationUsage {
  id        Int      @id @default(autoincrement())
  key       String                    // "customer:123" or "ip:x.x.x.x"
  date      DateTime @default(now())  // UTC date (midnight)
  count     Int      @default(0)
  shop      String
  updatedAt DateTime @updatedAt

  @@unique([key, date])
}
